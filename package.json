{
  "name": "vitesseeco",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0 <25.0.0"
  },
  "scripts": {
    "build": "nuxt build",
    "check:docs": "node scripts/check-docs.mjs",
    "check:feeds": "node scripts/check-feeds.mjs",
    "check:hex": "node scripts/check-hex-colors.mjs",
    "check:invariants": "node scripts/check-invariants.mjs",
    "check:langs": "node scripts/check-languages.mjs",
    "dev": "nuxt dev",
    "dev:db": "node scripts/dev-db.mjs",
    "generate": "nuxt generate",
    "postinstall": "nuxt prepare",
    "preview": "nuxt preview",
    "seed:inventory": "node scripts/seed-inventory.mjs",
    "simulate": "node tests/e2e/simulate.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npx playwright test --project=e2e",
    "test:e2e:ui": "npx playwright test --project=e2e --ui",
    "test:integration": "vitest run tests/integration",
    "test:money": "node tests/e2e/money-path.mjs",
    "test:unit": "vitest run tests/unit",
    "test:visual": "npx playwright test --project=visual",
    "test:visual:update": "npx playwright test --project=visual --update-snapshots",
    "test:watch": "vitest",
    "typecheck": "nuxi typecheck"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/icon": "^1.15.0",
    "@nuxt/image": "^2.0.0",
    "@nuxtjs/i18n": "^10.2.4",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@sanity/client": "^7.20.0",
    "@stripe/stripe-js": "^9.12.1",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "h3": "^1.15.11",
    "nuxt": "^3.17.5",
    "stripe": "^22.3.2",
    "vue": "^3.5.31",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^0.31.10",
    "embedded-postgres": "^18.4.0-beta.17",
    "pg": "^8.22.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.8",
    "wait-on": "^8.0.1"
  }
}
