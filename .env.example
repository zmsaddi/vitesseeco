# Vitesse Eco — environment
#
# Every variable below is read by code on this branch. Nothing here is
# aspirational: if a name appears, grep finds it in app/, server/, shared/,
# scripts/ or nuxt.config.ts. Copy to .env and fill in.
#
# Nuxt maps NUXT_-prefixed names onto runtimeConfig; the plain names are read
# straight from process.env.

# ── Catalogue (Sanity) ──────────────────────────────────────────────────────
SANITY_PROJECT_ID=2jvnjf0c
SANITY_DATASET=production
# Read server-side with a token so the dataset can be PRIVATE. Absence is fatal
# by default: an empty catalogue must never be served as if it were a real one.
SANITY_TOKEN=
# Local simulation escape hatch ONLY, while the dataset is still public. Set to
# 1 to read without a token; logs a loud warning on the first read.
# SANITY_ALLOW_PUBLIC_READ=1

# ── Database (PostgreSQL) ───────────────────────────────────────────────────
# The driver is chosen by what this URL IS: a *.neon.tech host gets the Neon
# serverless driver, anything else gets node-postgres. No flag to forget.
DATABASE_URL=
# Port for the local embedded PostgreSQL (npm run dev:db). Default 5544.
# DEV_DB_PORT=5544

# ── Secrets ─────────────────────────────────────────────────────────────────
# Signs price locks and session material. 32+ random bytes.
AUTH_SECRET=
# Salt for pseudonymising visitor IPs before they reach storage.
IP_HASH_SALT=

# ── Identity ────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated allowlist for /admin and every /api/admin route.
ADMIN_EMAILS=

# ── CAPTCHA (Cloudflare Turnstile) ──────────────────────────────────────────
# Verified server-side on contact, register, login and checkout.
# Automated runs use Cloudflare's public test pair, which always passes:
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
#   NUXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=
NUXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── Payments (Stripe) ───────────────────────────────────────────────────────
# Cash on delivery and in-store need no keys. Card checkout stays unavailable
# until these are set — the adapter registry hides what it cannot serve.
STRIPE_SECRET_KEY=
NUXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Scheduled work ──────────────────────────────────────────────────────────
# Authenticates /api/cron/maintenance: expires stale stock holds, sweeps
# abandoned orders, prunes sessions and rate-limit rows.
CRON_SECRET=

# ── Site ────────────────────────────────────────────────────────────────────
NUXT_PUBLIC_SITE_URL=https://vitesse-eco.fr
# An extra host allowed to originate state-changing requests (a platform alias,
# a preview URL, an additional market domain). The request's own Host is always
# accepted; this is only for genuinely cross-domain siblings.
# PUBLIC_SITE_HOST=

# ── Email — not wired ───────────────────────────────────────────────────────
# runtimeConfig reserves resendApiKey but no code on this branch sends mail.
# Password reset and order emails are blocked on this.
# RESEND_API_KEY=

# ── Test harness only ───────────────────────────────────────────────────────
# Where the browser simulation and the money-path walk point when no URL is
# passed on the command line.
# TEST_BASE_URL=http://127.0.0.1:3000

# ── Build-time only ─────────────────────────────────────────────────────────
# Override the CI bundle budget, in bytes. The default lives in the check script.
# BUNDLE_BUDGET_BYTES=
